{
  "name": "@zerocraft/engine",
  "version": "0.1.0",
  "description": "ZeroCraft Game Engine",
  "author": "ZeroCraft Game Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "exports": {
    "./engine/*": "./src/engine/*",
    "./skills/*": "./src/skills/*",
    "./atom-skills/*": "./src/skills/atoms/*",
    "./ui/*": "./src/ui/*",
    "./renderer/*": "./src/renderer/*",
    "./services/*": "./src/services/*",
    "./assets/*": "./src/assets/*",
    "./net/*": "./src/net/*",
    "./runtime/*": "./src/runtime/*",
    "./assembly/*": "./src/assembly/*",
    "./tsconfig.game-base.json": "./tsconfig.game-base.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite && vite --force",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src games --max-warnings 0",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src games",
    "test:watch": "vitest",
    "ui:audit": "node tools/ui-audit.mjs",
    "ledger:audit": "node scripts/ledger-audit.mjs",
    "demo": "vite-node src/assembly/demo.run.ts",
    "net:demo": "vite-node src/net/lockstep.demo.ts",
    "bench": "vite-node src/bench/run-bench.ts",
    "build:cartridge": "tsc --noEmit && vite build --config vite.config.cartridge.ts",
    "gen:registry": "vite-node scripts/gen-capability-registry.mjs",
    "build:cartridge:single": "VITE_SINGLEFILE=1 vite build --config vite.config.cartridge.ts",
    "pack:mac": "electron-builder --mac --config electron-builder.yml",
    "pack:win": "electron-builder --win --config electron-builder.yml",
    "pack:platform:mac": "electron-builder --mac --config electron-builder.platform.yml",
    "dist": "python3 scripts/dist.py",
    "test:deep": "ZEROCRAFT_DEEP=1 vitest run",
    "zerocraft": "node scripts/zerocraft.mjs"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "dependencies": {
    "@dokiworld/app-sdk": "^3.1.1",
    "@types/three": "^0.184.1",
    "cannon-es": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dependency-cruiser": "^16.10.4",
    "electron": "33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.0.5"
  }
}
