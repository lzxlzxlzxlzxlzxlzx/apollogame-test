    { "waitUntil": [{"comp": {"entity": "tile-r5c4", "component": "State", "field": "current"}, "eq": "tilled"}, {"res": "inv-pumpkin", "eq": 11}], "cap": 30 },
    // 点 tile-r5c5·收南瓜第 12/12 格：入背包恰 1 个·地块回「已翻土」（不判阶·理由见上）
    {"signal": "work", "args": {"tile": "tile-r5c5"}},
    { "waitUntil": [{"comp": {"entity": "tile-r5c5", "component": "State", "field": "current"}, "eq": "tilled"}, {"res": "inv-pumpkin", "eq": 12}], "cap": 30 },
    // 点 tile-r0c2·收小麦第 1/3 格（按作物路由：进的是 inv-wheat，不是别的包）
    {"signal": "work", "args": {"tile": "tile-r0c2"}},
    { "waitUntil": [{"comp": {"entity": "tile-r0c2", "component": "State", "field": "current"}, "eq": "tilled"}, {"res": "inv-wheat", "eq": 1}], "cap": 30 },
    // 点 tile-r0c3·收小麦第 2/3 格（按作物路由：进的是 inv-wheat，不是别的包）
    {"signal": "work", "args": {"tile": "tile-r0c3"}},
    { "waitUntil": [{"comp": {"entity": "tile-r0c3", "component": "State", "field": "current"}, "eq": "tilled"}, {"res": "inv-wheat", "eq": 2}], "cap": 30 },
    // 点 tile-r1c2·收小麦第 3/3 格（按作物路由：进的是 inv-wheat，不是别的包）
    {"signal": "work", "args": {"tile": "tile-r1c2"}},
    { "waitUntil": [{"comp": {"entity": "tile-r1c2", "component": "State", "field": "current"}, "eq": "tilled"}, {"res": "inv-wheat", "eq": 3}], "cap": 30 },
    // 背包就位、金币仍是 0——**还没卖**
    {"expect": [{"res": "inv-pumpkin", "eq": 12}, {"res": "inv-wheat", "eq": 3}, {"res": "inv-carrot", "eq": 0}, {"res": "gold", "eq": 0}]},
    // 卖货·第一次卖货：12×75 + 3×30 = **990**（§裁决行 A 的卖价）——差 10 金币不到线
    {"signal": "sell"},
    { "waitUntil": [{"res": "gold", "eq": 990}], "cap": 60 },
    // 观察窗：给流程系统三拍去（错误地）转移 —— 990 < 1000 必须**什么都不发生**
    {"tick": 3},
    // 990 不到 1000 → **仍是 playing**（通关线若写成 900/950/999，这里当场红）；背包已清空
    {"expect": [{"res": "gold", "eq": 990}, {"sv": "flow", "eq": "playing"}, {"res": "inv-pumpkin", "eq": 0}, {"res": "inv-wheat", "eq": 0}]},
    // ══ 终局 ══
    // 选工具 reap（词表 = hud.ts 的 TOOLS[].pickSignal）
    {"signal": "pick-reap"},
    // 等工具就位（先查后拍）
    {"waitUntil": [{"res": "tool", "eq": 3}], "cap": 30},
    // 点 tile-r0c0·收下那格胡萝卜（成熟后一直挂在田里没收）
    {"signal": "work", "args": {"tile": "tile-r0c0"}},
    { "waitUntil": [{"comp": {"entity": "tile-r0c0", "component": "State", "field": "current"}, "eq": "tilled"}, {"res": "inv-carrot", "eq": 1}], "cap": 30 },
    // **在卖之前**金币还是 990、流程还是 playing——阈值判的是金币，不是「背包里有货」
    {"expect": [{"res": "gold", "eq": 990}, {"sv": "flow", "eq": "playing"}, {"res": "inv-carrot", "eq": 1}, {"res": "energy", "eq": 4}]},
    // 卖货·第二次卖货：990 + 1×12 = **1002 ≥ 1000** → 通关（brief.md:46）
    {"signal": "sell"},
    { "waitUntil": [{"res": "gold", "eq": 1002}, {"sv": "flow", "eq": "won"}], "cap": 60 },
    // ══════════════════════════════════════════════════════════════
    // 【分段二 · 终局出口】brief.md:34「开始→操作→推进→**可重开**」
    // 词表：`restart` = 结算屏上的重开键（`data-action="restart"`·`hud.ts` 的 `HUD_ACTION.restart`）。
    // ⚠ `restart` 与其它信号**同名不同域**：它是**宿主动作**（`mountUI` 查得到本地 handler ⇒
    //   就地拆局重挂，不入队；`hud.ts:61` 明记「往世界里发名叫 restart 的信号 = 点了没反应且不报错」）。
    //   验收适配层直接喂 world ⇒ 需要一条约定：收到 `restart` = 拆本局世界、拿**剧本 seed**
    //   照原路径重挂一局（等价于宿主 handler 的行为）。**Lead 2026-09-18 已裁定**，
    //   落账 `requests.md §接线契约补遗②`（本作零随机 ⇒「同 seed / 换 seed」不可观测，取剧本 seed 是唯一确定选法）；
    //   重开后世界须回初态，见 README「接线约定」表。
    // 本段红 ⇒ **终局出口未接或重开没复位世界**，与上面的通关段无关（上面各步照常单独判）。
    // 对抗目标：上一局的记忆跟进新局（金币/日期/体力/工具下标/地块状态任一残留 → 红）。
    // ══════════════════════════════════════════════════════════════
    // 点重开（宿主生命周期：拆掉本局引擎照原路径重挂一局）
    {"signal": "restart"},
    { "waitUntil": [{"res": "gold", "eq": 0}, {"res": "day", "eq": 1}, {"res": "energy", "eq": 20}, {"res": "tool", "eq": 0}, {"sv": "flow", "eq": "playing"}, {"comp": {"entity": "tile-r0c0", "component": "State", "field": "current"}, "eq": "wild"}, {"comp": {"entity": "tile-r0c4", "component": "State", "field": "current"}, "eq": "wild"}, {"comp": {"entity": "tile-r5c5", "component": "State", "field": "current"}, "eq": "wild"}, {"comp": {"entity": "tile-r0c4", "component": "Resource", "field": "current"}, "eq": 0}], "cap": 90 },
    // 重开后的世界 = 初态：工具下标也回 0（重开前停在 reap=3，残留即红）
    {"expect": [{"res": "gold", "eq": 0}, {"res": "day", "eq": 1}, {"res": "energy", "eq": 20}, {"res": "tool", "eq": 0}, {"sv": "flow", "eq": "playing"}, {"res": "inv-pumpkin", "eq": 0}, {"res": "inv-carrot", "eq": 0}, {"comp": {"entity": "tile-r0c0", "component": "State", "field": "current"}, "eq": "wild"}, {"comp": {"entity": "tile-r0c4", "component": "State", "field": "current"}, "eq": "wild"}, {"comp": {"entity": "tile-r5c5", "component": "State", "field": "current"}, "eq": "wild"}, {"comp": {"entity": "tile-r0c4", "component": "Resource", "field": "current"}, "eq": 0}, {"comp": {"entity": "tile-r0c4", "component": "Flag", "field": "active"}, "eq": false}, {"flag": "grow-phase", "eq": false}]},
  ],
}
