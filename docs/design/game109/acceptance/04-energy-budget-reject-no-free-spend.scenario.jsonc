// GD-109 验收剧本 04 · 体力预算：**一天只够 20 个动作** · 体力不足的动作被拒且**不白扣**
//            （brief.md:15,17,62 P3 + §裁决行 A）。
// author: GD
//
// 条款出处：brief.md:15「一次动作 = 选定工具 + 点一个地块 = **扣 1 点体力**」
//          · brief.md:17「体力耗尽**不强制**结束一天（玩家自己决定何时睡）」
//          · brief.md:62 P3「**体力不足 → 该动作被拒**（前置满足也不行）」
//          · brief.md:16「睡觉 → 体力回满 → 日期 +1」
//          数值取 requests.md §裁决行 A：体力起始=上限=**20** · 每动作 **1** · 起始第 **1** 天 · 目标 1000。
//
// 本文件钉的两件事：
//   ① **预算**：20 格荒地各翻一次 = 20 个动作 → 体力**恰归 0**（不是 1、不是负数）。
//      阶梯断言写在每一格的 waitUntil 里（20→19→…→0），任何一次「没扣」或「多扣」都会当场红。
//   ② **拒绝不白扣**：体力 0 时，对一个**前置完全满足**的格子下手（已翻土的格子播种 / 荒地翻土）——
//      动作必须被拒，且体力**仍是 0**。这是 P3 的正面检验：
//      如果实现是「先扣体力再判门」，这里会看到 -1（或夹到 0 但格子被改了）→ 红。
//      最后睡觉回满后，**同一个动作**立刻成功 —— 证明前面红不是因为格子坏了，而是因为没体力。
//
// 对抗目标（把实现改坏成什么样，这条会变红）：
//   · **不扣体力 / 扣错数**（每次 1）→ 阶梯里某一格 `energy eq N` 红。
//   · **体力下限不是 0**（扣成 -1 / 扣成 1）→ 第 20 格的 `energy eq 0` 红。
//   · **体力 0 也能干活**（P3 的门缺失）→ 被拒那两步的 `state`/`energy` 断言红。
//   · **先扣体力再判门**（拒绝也白扣 1 点）→ 被拒那两步的 `energy eq 0` 红。
//   · **体力 0 就自动结束一天**（brief.md:17 明写不强制）→ 被拒那两步的 `day eq 1` 红。
//   · **睡觉不回满**（回一部分 / 回上限以外）→ `energy eq 20` 红。
//   · **被拒的动作改了地块**（翻土/播种的门形同虚设）→ `state` 断言红。
//
// 时序纪律：拒绝路径（「什么都没发生」）用固定观察窗 `{ "tick": 3 }`——waitUntil 表达不了「不变」。
//   逐格断言一律 `comp` + 显式实体 id。
{
  "name": "体力 20 的预算·体力耗尽动作被拒且不白扣",
  "game": "game109",
  "seed": 109,
  "steps": [
    // ── 开局：体力 20 · 第 1 天 · 未通关 ─────────────────────────────
    { "expect": [
      { "res": "energy", "eq": 20 },
      { "res": "day", "eq": 1 },
      { "res": "gold", "eq": 0 },
      { "sv": "flow", "eq": "playing" },
      { "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "wild" },
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },
    ] },

    // ── 20 格荒地各翻一次（工具开局即翻土，全程不换工具）──────────────
    //    每一格的 waitUntil 里带**当时应有的体力**：一次没扣、或一次扣了俩，都会当场红。
    { "signal": "work", "args": { "tile": "tile-r0c0" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 19 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c1" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r0c1", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 18 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c2" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r0c2", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 17 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c3" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r0c3", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 16 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c4" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r0c4", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 15 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c5" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r0c5", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 14 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r1c0" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r1c0", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 13 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r1c1" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r1c1", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 12 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r1c2" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r1c2", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 11 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r1c3" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r1c3", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 10 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r1c4" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r1c4", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 9 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r1c5" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r1c5", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 8 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r2c0" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r2c0", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 7 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r2c1" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r2c1", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 6 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r2c2" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r2c2", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 5 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r2c3" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r2c3", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 4 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r2c4" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r2c4", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 3 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r2c5" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r2c5", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 2 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r3c0" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r3c0", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 1 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r3c1" } },
    { "waitUntil": [{ "comp": { "entity": "tile-r3c1", "component": "State", "field": "current" }, "eq": "tilled" }, { "res": "energy", "eq": 0 }], "cap": 30 },
    { "expect": [
      { "res": "energy", "eq": 0 },           // 恰好用完，不是 -1
      { "res": "day", "eq": 1 },              // 体力耗尽**不强制**结束一天（brief.md:17）
      { "sv": "flow", "eq": "playing" },
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },  // 还没动过的第 21 格
    ] },

    // ── 拒绝①：体力 0 时给**已翻土**的格子播种（前置完全满足，只有体力不足）──
    { "signal": "pick-sow" },
    { "waitUntil": [{ "res": "tool", "eq": 1 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c0" } },
    { "tick": 3 },
    { "expect": [
      { "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "tilled" },   // 没被播
      { "comp": { "entity": "tile-r0c0", "component": "Resource", "field": "current" }, "eq": 0 },
      { "res": "energy", "eq": 0 },           // **没白扣**（先扣后判门的实现会看到 -1）
      { "res": "day", "eq": 1 },              // 也没被强制推进
      { "res": "inv-carrot", "eq": 0 },
      { "res": "inv-wheat", "eq": 0 },
      { "res": "inv-pumpkin", "eq": 0 },
    ] },

    // ── 拒绝②：体力 0 时翻一块**荒地**（前置满足，同样只有体力不足）──
    { "signal": "pick-till" },
    { "waitUntil": [{ "res": "tool", "eq": 0 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r3c2" } },
    { "tick": 3 },
    { "expect": [
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },    // 没被翻
      { "res": "energy", "eq": 0 },           // 没白扣
      { "res": "day", "eq": 1 },
      { "sv": "flow", "eq": "playing" },
    ] },

    // ── 拒绝③：体力 0 时浇水（地块前置也不满足）——双重不过门，仍不许有任何副作用 ──
    { "signal": "pick-water" },
    { "waitUntil": [{ "res": "tool", "eq": 2 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r3c2" } },
    { "tick": 3 },
    { "expect": [
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },
      { "comp": { "entity": "tile-r3c2", "component": "Flag", "field": "active" }, "eq": false },
      { "res": "energy", "eq": 0 },
      { "res": "day", "eq": 1 },
    ] },

    // ── 睡觉不是「干活」：**体力 0 也能睡**，睡完回满 ──────────────────
    { "signal": "sleep" },
    { "waitUntil": [
      { "res": "day", "eq": 2 },
      { "res": "energy", "eq": 20 },
      { "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "tilled" },
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },
    ], "cap": 60 },
    // 观察窗（3 拍）：睡觉的落定（生长/清标记）在**下一拍**，等它落定再判。
    { "tick": 3 },
    { "expect": [
      { "res": "day", "eq": 2 },
      { "res": "energy", "eq": 20 },
      { "res": "gold", "eq": 0 },             // 一整天只翻地，没赚到钱
      { "sv": "flow", "eq": "playing" },
      { "comp": { "entity": "tile-r0c0", "component": "Resource", "field": "current" }, "eq": 0 },   // 已翻土但没播种 ⇒ 不长
      { "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "tilled" },
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },
      { "flag": "grow-phase", "eq": false },
    ] },

    // ── 同一个被拒过的动作，体力回满后立刻成功（证明前面红是因为体力，不是格子坏了）──
    { "signal": "pick-sow" },
    { "waitUntil": [{ "res": "tool", "eq": 1 }], "cap": 30 },
    { "signal": "work", "args": { "tile": "tile-r0c0" } },
    { "waitUntil": [
      { "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "sown" },
      { "res": "energy", "eq": 19 },
    ], "cap": 30 },
    { "expect": [
      { "res": "energy", "eq": 19 },
      { "comp": { "entity": "tile-r0c0", "component": "State", "field": "current" }, "eq": "sown" },
      { "comp": { "entity": "tile-r0c0", "component": "Resource", "field": "current" }, "eq": 0 },
      { "comp": { "entity": "tile-r3c2", "component": "State", "field": "current" }, "eq": "wild" },   // 这块始终没被碰
    ] },
  ],
}
