  "name": "实时倒塌锁定并保留自然物理与战利品边界",
  "game": "game-105",
  "seed": 105031,
  "steps": [
    { "waitUntil": [ { "sv": "phase", "eq": "player-ready" } ], "cap": 600 },
    { "signal": "tower.drag", "args": { "blockId": "g105-block-08-01", "distanceRatio": 0.93 }, "by": "player" },
    { "waitUntil": [ { "sv": "phase", "eq": "collapse-locked" } ], "cap": 900 },
    { "expect": [
      { "sv": "loser", "eq": "player" },
      { "flag": "game-over", "eq": true },
