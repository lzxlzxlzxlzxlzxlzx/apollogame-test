      { "flag": "new-pulls-disabled", "eq": true },
      { "flag": "collapse-debris-produces-effects", "eq": false }
    ] },
    { "signal": "tower.restart", "by": "player" },
    { "waitUntil": [ { "sv": "phase", "eq": "player-ready" } ], "cap": 600 },
    { "expect": [
      { "sv": "turn", "eq": "player" },
      { "res": "heart-delta", "eq": 0 },
      { "res": "loot-count", "eq": 0 },
      { "flag": "game-over", "eq": false },
