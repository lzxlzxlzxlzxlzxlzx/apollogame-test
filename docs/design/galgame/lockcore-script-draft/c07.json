      "kind": "line",
      "text": {
        "zh-CN": "进来……"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0141"
      },
      "speaker": "tracy"
    },
    "c07_n0141": {
      "kind": "line",
      "text": {
        "zh-CN": "特蕾西睁开眼，伸手抱住他的背，脚勾着他的腰，把他往自己这边按，"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0142"
      }
    },
    "c07_n0142": {
      "kind": "line",
      "text": {
        "zh-CN": "都给我……"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0143"
      },
      "speaker": "luca"
    },
