      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0134"
      },
      "speaker": "luca"
    },
    "c07_n0134": {
      "kind": "line",
      "text": {
        "zh-CN": "唔……去了……卢卡……咿嗯……♡"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0135"
      },
      "speaker": "tracy"
    },
