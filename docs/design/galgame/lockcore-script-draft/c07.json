      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0132"
      },
      "speaker": "tracy"
    },
    "c07_n0132": {
      "kind": "line",
      "text": {
        "zh-CN": "特蕾西喘着，两条腿死死缠着他的腰，"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0133"
      }
    },
    "c07_n0133": {
      "kind": "line",
      "text": {
