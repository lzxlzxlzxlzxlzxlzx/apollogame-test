      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0123"
      },
      "speaker": "tracy"
    },
    "c07_n0123": {
      "kind": "line",
      "text": {
        "zh-CN": "特蕾西的胸随着他的动作晃起来，乳肉颤出浅浅的波。她伸手，抓着他的手按在自己胸上。"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0124"
      }
    },
    "c07_n0124": {
      "kind": "line",
      "text": {
        "zh-CN": "揉我……"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0125"
      },
      "speaker": "tracy"
    },
