      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0104"
      },
      "speaker": "luca"
    },
    "c07_n0104": {
      "kind": "line",
      "text": {
        "zh-CN": "她喘着，眼睛湿湿地看他，"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0105"
      }
    },
    "c07_n0105": {
      "kind": "line",
      "text": {
        "zh-CN": "但是……我更想要你。"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0106"
      },
      "speaker": "luca"
    },
    "c07_n0106": {
      "kind": "line",
      "text": {
        "zh-CN": "她伸手，抓着他的衣领往下拽。"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0107"
      }
    },
    "c07_n0107": {
      "kind": "line",
      "text": {
        "zh-CN": "你进来。"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0108"
      },
      "speaker": "tracy"
    },
    "c07_n0108": {
      "kind": "line",
      "text": {
        "zh-CN": "她说，"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0109"
      }
    },
    "c07_n0109": {
      "kind": "line",
      "text": {
        "zh-CN": "让它……一起。"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0110"
      },
      "speaker": "tracy"
    },
    "c07_n0110": {
      "kind": "line",
      "text": {
        "zh-CN": "卢卡脱了衣服。特蕾西把玩具从身体里抽出来，又放回穴口外贴着，让那个圆头抵在她最敏感的那点上。她自己抬腿，勾住卢卡的腰。"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0111"
      }
    },
    "c07_n0111": {
      "kind": "line",
      "text": {
        "zh-CN": "今天……"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0112"
      },
      "speaker": "luca"
    },
    "c07_n0112": {
      "kind": "line",
      "text": {
        "zh-CN": "她喘着，"
      },
      "next": {
        "chapterId": "c07",
        "nodeId": "c07_n0113"
      }
    },
    "c07_n0113": {
      "kind": "line",
      "text": {
