          "requires": { "kind": "flag", "id": "flag.throne-lit", "equals": true },
          "completedSkinKey": "art:demon-castle:building:greenhouse-restored"
        },
        {
          "id": "awaken-forge-core",
          "placementId": "forge-core",
          "materials": [{ "itemId": "resource.shadow-ore", "count": 2 }, { "itemId": "resource.moonwood", "count": 1 }],
          "requires": { "kind": "flag", "id": "flag.greenhouse-restored", "equals": true },
          "completedSkinKey": "art:demon-castle:building:forge-core-awakened"
        }
